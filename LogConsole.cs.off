using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Runtime.InteropServices;
using System.Windows.Forms;

sealed class LogConsole : Panel {
    readonly LogTextBox editor;
    readonly LogScrollBar scrollBar;
    readonly Timer highlightTimer;
    readonly Font logFont;
    readonly Font errorFont;
    int highlightedStart = -1;
    int highlightedLength;

    static readonly Color HighlightBack = Color.FromArgb(60, 48, 93);

    public LogConsole() {
        BackColor = LUi.Panel;
        AccessibleRole = AccessibleRole.Grouping;
        AccessibleName = "Log do launcher";
        AccessibleDescription = "Histórico de eventos do launcher. Área somente leitura; use a roda do mouse, teclado ou a barra lateral para percorrer o histórico.";
        SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);

        logFont = new Font("Consolas", 9.5f, FontStyle.Regular, GraphicsUnit.Point);
        errorFont = new Font("Consolas", 9.5f, FontStyle.Bold, GraphicsUnit.Point);
        editor = new LogTextBox {
            BorderStyle = BorderStyle.None,
            DetectUrls = false,
            Dock = DockStyle.None,
            Font = logFont,
            BackColor = LUi.Panel,
            ForeColor = LUi.Txt,
            HideSelection = false,
            Multiline = true,
            ReadOnly = true,
            ScrollBars = RichTextBoxScrollBars.None,
            TabStop = true,
            WordWrap = true,
            AccessibleName = "Histórico do log",
            AccessibleDescription = "Mensagens selecionáveis e copiáveis. A rolagem funciona com a roda do mouse, teclado e barra lateral.",
            TabIndex = 0,
        };
        editor.ScrollPositionChanged += (_, _) => SyncScrollBar();
        editor.TextChanged += (_, _) => SyncScrollBar();
        Controls.Add(editor);

        scrollBar = new LogScrollBar(this) {
            AccessibleName = "Rolar o histórico do log",
            AccessibleDescription = "Arraste a alça, clique na trilha ou use as setas e Page Up/Page Down.",
            AccessibleRole = AccessibleRole.ScrollBar,
            TabStop = true,
            TabIndex = 1,
        };
        Controls.Add(scrollBar);

        highlightTimer = new Timer { Interval = 300 };
        highlightTimer.Tick += (_, _) => ClearHighlight();
        LayoutChildren();
    }

    public void AppendEntry(string message, DateTime timestamp) {
        if (string.IsNullOrEmpty(message) || IsDisposed) return;

        bool wasAtBottom = FirstVisibleLine >= MaximumTopLine;
        int previousTopLine = FirstVisibleLine;
        int previousSelectionStart = editor.SelectionStart;
        int previousSelectionLength = editor.SelectionLength;
        bool followTail = wasAtBottom && previousSelectionLength == 0 && previousSelectionStart >= editor.TextLength - 1;
        ClearHighlight();

        int start = editor.TextLength;
        bool isError = IsErrorMessage(message);
        editor.SelectionStart = start;
        editor.SelectionLength = 0;
        editor.SelectionBackColor = LUi.Panel;
        editor.SelectionFont = logFont;
        editor.SelectionColor = LUi.Dim;
        editor.AppendText($"[{timestamp:HH:mm:ss}] ");

        editor.SelectionFont = isError ? errorFont : logFont;
        editor.SelectionColor = isError ? LUi.Red : LUi.Txt;
        editor.AppendText(message);
        editor.AppendText(Environment.NewLine);

        highlightedStart = start;
        highlightedLength = editor.TextLength - start;
        editor.SelectionStart = highlightedStart;
        editor.SelectionLength = highlightedLength;
        editor.SelectionBackColor = HighlightBack;

        if (followTail) {
            editor.SelectionStart = editor.TextLength;
            editor.SelectionLength = 0;
            editor.ScrollToCaret();
        } else {
            editor.SelectionStart = Math.Min(previousSelectionStart, editor.TextLength);
            editor.SelectionLength = Math.Min(previousSelectionLength, editor.TextLength - editor.SelectionStart);
            ScrollToLine(Math.Min(previousTopLine, MaximumTopLine));
        }

        highlightTimer.Stop();
        highlightTimer.Start();
        SyncScrollBar();
    }

    internal int FirstVisibleLine => SendMessage(editor.Handle, EmGetFirstVisibleLine, IntPtr.Zero, IntPtr.Zero).ToInt32();

    internal int LineCount => Math.Max(1, SendMessage(editor.Handle, EmGetLineCount, IntPtr.Zero, IntPtr.Zero).ToInt32());

    internal int VisibleLineCount {
        get {
            if (!editor.IsHandleCreated || editor.ClientSize.Height <= 0) return 1;
            int first = FirstVisibleLine;
            int lastChar = editor.GetCharIndexFromPosition(new Point(1, Math.Max(0, editor.ClientSize.Height - 2)));
            int last = editor.GetLineFromCharIndex(Math.Max(0, lastChar));
            return Math.Max(1, last - first + 1);
        }
    }

    internal int MaximumTopLine => Math.Max(0, LineCount - VisibleLineCount);

    internal void ScrollToLine(int line) {
        if (!editor.IsHandleCreated) return;
        int target = Math.Max(0, Math.Min(MaximumTopLine, line));
        int delta = target - FirstVisibleLine;
        if (delta != 0)
            SendMessage(editor.Handle, EmLineScroll, IntPtr.Zero, new IntPtr(delta));
        SyncScrollBar();
    }

    internal void ScrollByLines(int lines) => ScrollToLine(FirstVisibleLine + lines);

    protected override void OnPaint(PaintEventArgs e) {
        base.OnPaint(e);
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        using var pen = new Pen(LUi.Line);
        using var path = LUi.Round(new Rectangle(0, 0, Width - 1, Height - 1), 5);
        e.Graphics.DrawPath(pen, path);
    }

    protected override void OnSizeChanged(EventArgs e) {
        base.OnSizeChanged(e);
        LayoutChildren();
        SyncScrollBar();
    }

    protected override void Dispose(bool disposing) {
        if (disposing) {
            highlightTimer.Stop();
            highlightTimer.Dispose();
            logFont.Dispose();
            errorFont.Dispose();
        }
        base.Dispose(disposing);
    }

    void LayoutChildren() {
        if (editor == null || scrollBar == null) return;
        const int inset = 8;
        const int railWidth = 10;
        const int gap = 8;
        editor.SetBounds(inset, inset, Math.Max(0, Width - inset * 2 - railWidth - gap), Math.Max(0, Height - inset * 2));
        scrollBar.SetBounds(Width - inset - railWidth, inset, railWidth, Math.Max(0, Height - inset * 2));
    }

    void SyncScrollBar() {
        if (scrollBar == null || IsDisposed) return;
        scrollBar.SyncFromOwner();
    }

    void ClearHighlight() {
        highlightTimer?.Stop();
        if (highlightedStart < 0 || highlightedLength <= 0 || editor.IsDisposed) return;

        int selectionStart = editor.SelectionStart;
        int selectionLength = editor.SelectionLength;
        editor.SelectionStart = Math.Min(highlightedStart, editor.TextLength);
        editor.SelectionLength = Math.Min(highlightedLength, editor.TextLength - editor.SelectionStart);
        editor.SelectionBackColor = LUi.Panel;
        editor.SelectionStart = Math.Min(selectionStart, editor.TextLength);
        editor.SelectionLength = Math.Min(selectionLength, editor.TextLength - editor.SelectionStart);
        highlightedStart = -1;
        highlightedLength = 0;
    }

    static bool IsErrorMessage(string message) =>
        message.StartsWith("ERRO", StringComparison.OrdinalIgnoreCase) ||
        message.StartsWith("Falha", StringComparison.OrdinalIgnoreCase);

    const int EmGetFirstVisibleLine = 0x00CE;
    const int EmGetLineCount = 0x00BA;
    const int EmLineScroll = 0x00B6;

    [DllImport("user32.dll", CharSet = CharSet.Auto)]
    static extern IntPtr SendMessage(IntPtr hWnd, int msg, IntPtr wParam, IntPtr lParam);

    sealed class LogTextBox : RichTextBox {
        const int WmVScroll = 0x0115;
        const int WmHScroll = 0x0114;
        const int WmMouseWheel = 0x020A;
        const int WmKeyDown = 0x0100;
        const int WmKeyUp = 0x0101;
        const int WmSize = 0x0005;

        public event EventHandler ScrollPositionChanged;

        protected override void WndProc(ref Message m) {
            int message = m.Msg;
            base.WndProc(ref m);
            if (message == WmVScroll || message == WmHScroll || message == WmMouseWheel ||
                message == WmKeyDown || message == WmKeyUp || message == WmSize)
                ScrollPositionChanged?.Invoke(this, EventArgs.Empty);
        }
    }

    sealed class LogScrollBar : Control {
        readonly LogConsole owner;
        bool dragging;
        bool hovering;
        int dragOffset;
        Rectangle thumbBounds;

        public LogScrollBar(LogConsole owner) {
            this.owner = owner;
            BackColor = LUi.Panel;
            Cursor = Cursors.Hand;
            SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.Selectable, true);
        }

        protected override bool IsInputKey(Keys keyData) =>
            keyData is Keys.Up or Keys.Down or Keys.PageUp or Keys.PageDown or Keys.Home or Keys.End || base.IsInputKey(keyData);

        protected override void OnPaint(PaintEventArgs e) {
            base.OnPaint(e);
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            thumbBounds = CalculateThumbBounds();
            if (thumbBounds.IsEmpty) return;

            var track = new RectangleF(Width / 2f - 1f, 3, 2, Math.Max(0, Height - 6));
            using var trackBrush = new SolidBrush(LUi.Line);
            using var thumbBrush = new SolidBrush(dragging || hovering || Focused ? LUi.Acc : LUi.InputLine);
            using var trackPath = LUi.Round(Rectangle.Round(track), 2);
            using var thumbPath = LUi.Round(thumbBounds, Math.Min(4, thumbBounds.Height / 2));
            e.Graphics.FillPath(trackBrush, trackPath);
            e.Graphics.FillPath(thumbBrush, thumbPath);

            if (Focused) {
                using var focusPen = new Pen(LUi.Focus, 1f);
                e.Graphics.DrawPath(focusPen, thumbPath);
            }
        }

        protected override void OnMouseEnter(EventArgs e) {
            base.OnMouseEnter(e);
            hovering = true;
            Invalidate();
        }

        protected override void OnMouseLeave(EventArgs e) {
            base.OnMouseLeave(e);
            hovering = false;
            if (!dragging) Invalidate();
        }

        protected override void OnMouseDown(MouseEventArgs e) {
            base.OnMouseDown(e);
            if (e.Button != MouseButtons.Left || owner.MaximumTopLine <= 0) return;
            Focus();
            thumbBounds = CalculateThumbBounds();
            if (thumbBounds.Contains(e.Location)) {
                dragging = true;
                dragOffset = e.Y - thumbBounds.Top;
                Capture = true;
            } else {
                int page = Math.Max(1, owner.VisibleLineCount - 1);
                owner.ScrollByLines(e.Y < thumbBounds.Top ? -page : page);
            }
            Invalidate();
        }

        protected override void OnMouseMove(MouseEventArgs e) {
            base.OnMouseMove(e);
            if (!dragging) return;

            var track = TrackBounds();
            int travel = Math.Max(1, track.Height - thumbBounds.Height);
            int thumbTop = Math.Max(track.Top, Math.Min(track.Bottom - thumbBounds.Height, e.Y - dragOffset));
            float fraction = (thumbTop - track.Top) / (float)travel;
            owner.ScrollToLine((int)Math.Round(fraction * owner.MaximumTopLine));
        }

        protected override void OnMouseUp(MouseEventArgs e) {
            base.OnMouseUp(e);
            dragging = false;
            Capture = false;
            Invalidate();
        }

        protected override void OnMouseWheel(MouseEventArgs e) {
            owner.ScrollByLines(-Math.Sign(e.Delta) * Math.Max(1, Math.Abs(e.Delta) / SystemInformation.MouseWheelScrollDelta) * 3);
            base.OnMouseWheel(e);
        }

        protected override void OnKeyDown(KeyEventArgs e) {
            base.OnKeyDown(e);
            int page = Math.Max(1, owner.VisibleLineCount - 1);
            switch (e.KeyCode) {
                case Keys.Up: owner.ScrollByLines(-1); break;
                case Keys.Down: owner.ScrollByLines(1); break;
                case Keys.PageUp: owner.ScrollByLines(-page); break;
                case Keys.PageDown: owner.ScrollByLines(page); break;
                case Keys.Home: owner.ScrollToLine(0); break;
                case Keys.End: owner.ScrollToLine(owner.MaximumTopLine); break;
                default: return;
            }
            e.Handled = true;
            e.SuppressKeyPress = true;
        }

        internal void SyncFromOwner() => Invalidate();

        Rectangle TrackBounds() => new Rectangle(Width / 2 - 1, 3, 2, Math.Max(0, Height - 6));

        Rectangle CalculateThumbBounds() {
            int total = owner.LineCount;
            int visible = owner.VisibleLineCount;
            int maxTop = Math.Max(0, total - visible);
            var track = TrackBounds();
            if (maxTop <= 0 || track.Height <= 0) return Rectangle.Empty;

            int thumbHeight = Math.Max(18, (int)Math.Round(track.Height * (visible / (double)total)));
            thumbHeight = Math.Min(track.Height, thumbHeight);
            int travel = Math.Max(0, track.Height - thumbHeight);
            int first = Math.Max(0, Math.Min(maxTop, owner.FirstVisibleLine));
            int top = track.Top + (int)Math.Round(travel * (first / (double)maxTop));
            return new Rectangle(Width / 2 - 4, top, 8, thumbHeight);
        }
    }
}
